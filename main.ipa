import SwiftUI
import ProfileManager

struct ContentView: View {
    @State private var isInstalled = false
    
    var body: some View {
        VStack(spacing: 20) {
            Text(isInstalled ? "Profile Installed" : "Profile Not Installed")
                .font(.title)
            
            Button(isInstalled ? "Uninstall Profile" : "Install Profile") {
                if isInstalled {
                    uninstallProfile()
                } else {
                    installProfile()
                }
            }
            .buttonStyle(.borderedProminent)
        }
        .padding()
    }
    
    func installProfile() {
        // Load and install profile
        guard let url = Bundle.main.url(forResource: "profile", withExtension: "mobileconfig") else { return }
        
        let profile = Profile(url: url)
        do {
            try profile.install()
            isInstalled = true
        } catch {
            print("Installation failed: \(error)")
        }
    }
    
    func uninstallProfile() {
        // Remove profile
        let profile = Profile(name: "My Profile")
        do {
            try profile.uninstall()
            isInstalled = false
        } catch {
            print("Uninstallation failed: \(error)")
        }
    }
}
